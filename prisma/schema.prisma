// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
  DOCTOR
  PATIENT
  NURSE
}

enum BedType {
  GENERAL
  ICU
  EMERGENCY
  PRIVATE
  ISOLATION
}

enum BedStatus {
  AVAILABLE
  LOCKED
  BOOKED
  OCCUPIED
  CLEANING
  MAINTENANCE
}

enum BookingStatus {
  LOCKED
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum AdmissionStatus {
  PENDING
  ADMITTED
  DISCHARGED
}

enum CleaningTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum MaintenanceTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NursingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ICUWaitlistStatus {
  WAITING
  NOTIFIED
  FULFILLED
  CANCELLED
  EXPIRED
}

enum NotificationType {
  ICU_BED_AVAILABLE
}

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
  PUSH
}

enum NotificationEventType {
  BED_LOCKED
  LOCK_EXPIRING
  BOOKING_CONFIRMED
  BED_ASSIGNED
  DISCHARGE_COMPLETED
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Hospital {
  id        String   @id @default(uuid())
  name      String
  address   String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beds Bed[]
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings           Booking[]
  lockedBeds         Bed[]              @relation("LockedBy")
  bedStatusChanges   BedStatusHistory[]
  admissions         Admission[]
  cleaningTasks      CleaningTask[]
  maintenanceTasks   MaintenanceTask[]
  nursingTasks       NursingTask[]
  auditLogs          AuditLog[]
  sessions           Session[]
  icuWaitlistEntries ICUWaitlistEntry[]
  notifications      Notification[]
  notificationJobs   NotificationJob[]
  pushSubscriptions  PushSubscription[]
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Patient {
  id          String   @id @default(uuid())
  name        String
  phone       String
  dateOfBirth DateTime
  gender      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings           Booking[]
  beds               Bed[]
  admissions         Admission[]
  nursingTasks       NursingTask[]
  icuWaitlistEntries ICUWaitlistEntry[]
}

model Bed {
  id          String    @id @default(uuid())
  hospitalId  String
  bedNumber   String
  bedType     BedType
  ward        String
  floor       Int
  status      BedStatus @default(AVAILABLE)
  lockedById  String?
  lockedUntil DateTime?
  patientId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  lockedBy User?    @relation("LockedBy", fields: [lockedById], references: [id])
  patient  Patient? @relation(fields: [patientId], references: [id])

  bookings         Booking[]
  statusHistory    BedStatusHistory[]
  admissions       Admission[]
  cleaningTasks    CleaningTask[]
  maintenanceTasks MaintenanceTask[]
  nursingTasks     NursingTask[]

  @@unique([hospitalId, bedNumber])
  @@index([hospitalId])
  @@index([status])
  @@index([bedType])
  @@index([lockedUntil])
  @@index([patientId])
}

model Booking {
  id            String        @id @default(uuid())
  bedId         String
  patientId     String?
  bookedById    String
  status        BookingStatus
  lockExpiresAt DateTime?
  bookedAt      DateTime      @default(now())
  admissionAt   DateTime?
  dischargeAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bed      Bed      @relation(fields: [bedId], references: [id])
  patient  Patient? @relation(fields: [patientId], references: [id])
  bookedBy User     @relation(fields: [bookedById], references: [id])

  admission Admission?

  @@index([bedId])
  @@index([patientId])
  @@index([bookedById])
  @@index([status])
}

model Admission {
  id           String          @id @default(uuid())
  bookingId    String          @unique
  bedId        String
  patientId    String
  admittedById String
  admittedAt   DateTime        @default(now())
  dischargedAt DateTime?
  status       AdmissionStatus @default(ADMITTED)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  booking    Booking @relation(fields: [bookingId], references: [id])
  bed        Bed     @relation(fields: [bedId], references: [id])
  patient    Patient @relation(fields: [patientId], references: [id])
  admittedBy User    @relation(fields: [admittedById], references: [id])

  @@index([bedId])
  @@index([patientId])
  @@index([status])
  @@index([admittedAt])
}

model CleaningTask {
  id          String             @id @default(uuid())
  bedId       String
  assignedTo  String
  status      CleaningTaskStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  completedAt DateTime?

  bed      Bed  @relation(fields: [bedId], references: [id])
  assignee User @relation(fields: [assignedTo], references: [id])

  @@index([bedId])
  @@index([status])
  @@index([assignedTo])
}

model MaintenanceTask {
  id          String                @id @default(uuid())
  bedId       String
  assignedTo  String
  title       String
  description String?
  priority    TaskPriority          @default(NORMAL)
  status      MaintenanceTaskStatus @default(PENDING)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  completedAt DateTime?

  bed      Bed  @relation(fields: [bedId], references: [id])
  assignee User @relation(fields: [assignedTo], references: [id])

  @@index([bedId])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
}

model NursingTask {
  id          String            @id @default(uuid())
  bedId       String
  patientId   String?
  assignedTo  String
  title       String
  description String?
  priority    TaskPriority      @default(NORMAL)
  status      NursingTaskStatus @default(PENDING)
  dueAt       DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  completedAt DateTime?

  bed      Bed      @relation(fields: [bedId], references: [id])
  patient  Patient? @relation(fields: [patientId], references: [id])
  assignee User     @relation(fields: [assignedTo], references: [id])

  @@index([bedId])
  @@index([patientId])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
  @@index([dueAt])
}

model ICUWaitlistEntry {
  id                 String            @id @default(uuid())
  patientId          String
  requestedById      String
  clinicalUrgency    Int
  requiresVentilator Boolean           @default(false)
  notes              String?
  priorityScore      Int
  status             ICUWaitlistStatus @default(WAITING)
  notifiedAt         DateTime?
  fulfilledAt        DateTime?
  expiresAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id])
  requestedBy   User           @relation(fields: [requestedById], references: [id])
  notifications Notification[]

  @@index([status, priorityScore, createdAt])
  @@index([patientId])
  @@index([requestedById])
}

model Notification {
  id              String           @id @default(uuid())
  userId          String
  waitlistEntryId String?
  type            NotificationType
  title           String
  message         String
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  user          User              @relation(fields: [userId], references: [id])
  waitlistEntry ICUWaitlistEntry? @relation(fields: [waitlistEntryId], references: [id])

  @@index([userId, readAt])
  @@index([waitlistEntryId])
  @@index([createdAt])
}

model NotificationJob {
  id          String                @id @default(uuid())
  userId      String?
  channel     NotificationChannel
  eventType   NotificationEventType
  recipient   String
  subject     String?
  message     String
  payload     Json?
  status      NotificationJobStatus @default(PENDING)
  attempts    Int                   @default(0)
  scheduledAt DateTime              @default(now())
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([userId])
  @@index([eventType])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BedStatusHistory {
  id          String    @id @default(uuid())
  bedId       String
  oldStatus   BedStatus
  newStatus   BedStatus
  changedById String
  createdAt   DateTime  @default(now())

  bed       Bed  @relation(fields: [bedId], references: [id])
  changedBy User @relation(fields: [changedById], references: [id])

  @@index([bedId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String
  metadata   String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}
